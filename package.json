{
  "name": "budmon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:int",
    "test": "vitest run --project=!server-int",
    "test:int": "vitest run --project=server-int",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@budmon/config": "workspace:*",
    "@budmon/tools-ci": "workspace:*",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
