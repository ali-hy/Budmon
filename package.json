{
  "name": "budmon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm test:int",
    "test": "vitest run --project=!server-int",
    "test:int": "vitest run --project=server-int",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/server/tsconfig.json",
    "test:coverage": "vitest run --project=shared --coverage",
    "dev": "pnpm --filter @budmon/server dev",
    "db:reset": "pnpm --filter @budmon/server db:reset",
    "db:seed": "pnpm --filter @budmon/server db:seed",
    "db:migrate": "pnpm --filter @budmon/server db:migrate"
  },
  "devDependencies": {
    "@budmon/config": "workspace:*",
    "@budmon/shared": "workspace:*",
    "@budmon/tools-ci": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
